# =============================================================================
# API KEYS & ENDPOINTS
# Default BASE_URL uses official endpoints. Replace with proxy URL when needed.
# =============================================================================

# --- Google AI (Veo) ---
GOOGLE_API_KEY=your_google_api_key
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com

# --- OpenAI ---
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Kling AI ---
KLING_ACCESS_KEY=your_kling_access_key
KLING_SECRET_KEY=your_kling_secret_key
KLING_BASE_URL=https://api-singapore.klingai.com

# --- Hailuo AI / MiniMax ---
HAILUO_API_KEY=your_hailuo_api_key
HAILUO_BASE_URL=https://api.minimax.io/v1

# --- Fal.ai ---
FAL_API_KEY=your_fal_api_key
FAL_BASE_URL=https://queue.fal.run

# --- Volcano Engine / Seedance ---
VOLCANO_API_KEY=your_volcano_api_key
VOLCANO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
PORT=3001
NODE_ENV=development
