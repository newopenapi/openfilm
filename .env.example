# ===========================================
# AI Film - Environment Configuration
# ===========================================

# Server Configuration
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=/api

# Storage
STORAGE_PROVIDER=local
USE_TENCENT_COS=0

# Database Configuration (MySQL 8.0+)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=openfilm
DATABASE_URL=mysql://root:root@localhost:3306/openfilm

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ===========================================
# Payments (Alipay / WeChat Pay)
# ===========================================
PAYMENTS_MODE=mock
PUBLIC_API_BASE_URL=http://localhost:3001

# Alipay
ALIPAY_APP_ID=your-alipay-app-id
ALIPAY_PRIVATE_KEY=your-alipay-private-key-pem-or-one-line
ALIPAY_PUBLIC_KEY=your-alipay-public-key-pem-or-one-line
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# WeChat Pay v3
WECHATPAY_MCH_ID=your-mch-id
WECHATPAY_APP_ID=your-app-id
WECHATPAY_CERT_SERIAL=your-cert-serial
WECHATPAY_PRIVATE_KEY=your-merchant-private-key-pem-or-one-line
WECHATPAY_API_V3_KEY=your-api-v3-key-32chars
WECHATPAY_PLATFORM_PUBLIC_KEY=your-platform-public-key-pem-or-one-line
WECHATPAY_API_BASE=https://api.mch.weixin.qq.com

# ===========================================
# AI API Keys
# ===========================================

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key

# Kling AI (Video Generation)
KLING_ACCESS_KEY=your-kling-access-key
KLING_SECRET_KEY=your-kling-secret-key
KLING_BASE_URL=https://api-singapore.klingai.com

# Hailuo AI (Video Generation)
HAILUO_API_KEY=your-hailuo-api-key
HAILUO_BASE_URL=https://api.minimax.io/v1

# OpenAI (GPT Image)
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

# Fal.ai (Motion Control)
FAL_API_KEY=your-fal-api-key
FAL_BASE_URL=https://queue.fal.run

# Volcano Engine / Seedance (ByteDance)
VOLCANO_API_KEY=your-volcano-api-key
VOLCANO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCANO_ACCESS_KEY=your-volc-ak
VOLCANO_SECRET_KEY=your-volc-sk
VOLC_OPENAPI_REGION=cn-north-1
VOLC_ARK_PROJECT_NAME=default
PUBLIC_FILE_BASE_URL=http://localhost:3001

# Doubao (豆包 2.0 聊天模型) - 可以复用 VOLCANO_API_KEY
DOUBAN_API_KEY=your-doubao-api-key
DOUBAN_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# NanoBanana (Gemini Image Alternative)
NANOBANANA_API_KEY=your-nanobanana-api-key
NANOBANANA_BASE_URL=https://open.bsv.vip

# ===========================================
# Tencent Cloud COS (File Storage)
# ===========================================
TENCENT_COS_SECRET_ID=your-tencent-secret-id
TENCENT_COS_SECRET_KEY=your-tencent-secret-key
TENCENT_COS_BUCKET=your-bucket-name
TENCENT_COS_REGION=ap-beijing
TENCENT_COS_CDN_DOMAIN=https://cdn.yourdomain.com

# ===========================================
# Twitter/X API (Post Feature)
# ===========================================
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_ACCESS_TOKEN=your-twitter-access-token
TWITTER_ACCESS_SECRET=your-twitter-access-secret
